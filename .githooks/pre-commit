#!/bin/sh
# Pre-commit hook: run formatting check, vet, and fast unit tests
# before allowing a commit. Failures abort the commit with a clear
# message; pass --no-verify to bypass (use sparingly).
#
# Calls gofumpt and go directly so it doesn't depend on `make` being
# installed — works on Windows (Git Bash), macOS, and Linux.
#
# Enable in a fresh clone with:
#   git config core.hooksPath .githooks
#
# See docs/dev/development.md for the full local-dev workflow.

set -e

red()   { printf "\033[31m%s\033[0m\n" "$*"; }
green() { printf "\033[32m%s\033[0m\n" "$*"; }

# ---- Conflict-marker check (applies to ALL files, not just Go) ----
# Catches the case where a cherry-pick / merge / rebase left unresolved
# markers in a file the rest of this hook would skip (the Go-only gate
# below let CHANGELOG.md markers slip through to main on the v0.74.0
# cycle's F5 cherry-pick). Checks `<<<<<<<` and `>>>>>>>` only — those
# are unambiguous; `=======` alone matches legitimate Setext underlines
# in markdown.
markers_files=$(git diff --cached --name-only --diff-filter=ACM | xargs -r grep -lE '^(<<<<<<<|>>>>>>>)' 2>/dev/null || true)
if [ -n "$markers_files" ]; then
	red "pre-commit: unresolved merge-conflict markers in staged files:"
	echo "$markers_files"
	echo ""
	echo "Resolve the conflicts and re-stage before committing."
	exit 1
fi

# ---- tree-hygiene guard (applies to ALL files, not just Go) ----
# Fails when a scratch/editor artefact (*.tmp, *.bak, *.orig, *.rej,
# *~, *.swp, .DS_Store, Thumbs.db) is TRACKED — the index, so a
# freshly-`git add`ed one is caught before the commit that would track
# it. A .driftblock.tmp fragment reached main by a broad `git add` and
# sat tracked for a day; every gate below validates the CODE's health
# and none validates the TREE's shape.
#
# Deliberately ABOVE the "no Go files staged" early return: the
# incident file was Go source with a .tmp name, so it matched neither
# the \.go$ filter nor anything after it.
if ! sh scripts/check-tree-hygiene.sh; then
	red "pre-commit: check-tree-hygiene failed (a scratch/editor artefact is tracked in git)."
	exit 1
fi

# ---- NUL-byte guard on staged text files ----
# AI-tooling parameter layers decode a literal backslash-u-0000 sequence
# into a real NUL byte; this has reached committed docs 4x (2026-07-16).
# A NUL in a text file flips grep/ripgrep into binary mode repo-wide.
#
# Deliberately ABOVE the "no Go files staged" early return, for the same
# reason check-tree-hygiene is (audit 2026-08-05 C-16): every incident this
# guard names happened in a MARKDOWN file, and a docs-only commit is exactly
# the shape that used to skip it. CI skips docs-only pushes too, so this hook
# was the only thing standing in that path — and it was standing in the wrong
# place. A guard whose motivating incidents are all in the class it cannot
# see is worse than none, because its presence reads as coverage.
nul_hits=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(md|go|yml|yaml|sh|ps1|txt)$' | while read -r f; do
	[ -f "$f" ] && LC_ALL=C grep -qP '\x00' "$f" && echo "$f"
done)
if [ -n "$nul_hits" ]; then
	red "pre-commit: staged text file(s) contain a literal NUL byte:"
	echo "$nul_hits"
	echo "Spell the escape in prose (backslash-u-0000) instead."
	exit 1
fi

# ---- merge-conflict-marker guard on staged text files ----
# A stray conflict marker survived a manual resolution into a committed
# doc once (2026-07-17): the error-code doc-sync test parses table rows
# and skips other lines, so a leftover "<<<<<<< HEAD" rode a green gate.
# Match a line-start marker followed by a space or EOL (the real conflict
# shape), so prose/underlines like "=======" in a NOTICE don't false-fire.
# Above the early return for the same reason as the NUL guard.
conflict_hits=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(md|go|yml|yaml|sh|ps1|txt)$' | while read -r f; do
	[ -f "$f" ] && grep -Eq '^(<{7}|>{7}) |^<{7}$|^>{7}$' "$f" && echo "$f"
done)
if [ -n "$conflict_hits" ]; then
	red "pre-commit: staged text file(s) contain a merge-conflict marker:"
	echo "$conflict_hits"
	echo "Finish resolving the conflict before committing."
	exit 1
fi

# ---- CI Lint-job parity: the artifact guards (audit T-7) ----
# These run in CI's Lint job on EVERY push (not gated on staged Go files),
# so the local gate must too — a workflow-YAML, skills-markdown, or
# capability change that touches NO Go would otherwise pass the whole local
# gate and fail only in CI, breaking the "pre-commit runs everything CI
# runs" contract. Two of them (schedule-consumers, leg-nonvacuity-coverage)
# inspect workflow YAML that a Go-only gate would never see, which is
# exactly why they sit ABOVE the Go-staged early return — and so does
# check-notes-claims-selftest, for the sharpest version of that reason: the
# thing it guards is a SHELL script, so the commit that breaks it is by
# definition one with no Go files staged (this guard was first placed below
# the early return and was unreachable in exactly the case it exists for).
# Invoked via `bash`
# (not `sh`): leg-nonvacuity-coverage uses bash-only here-strings, and `sh`
# is dash on Linux/macOS. All are sub-second grep/git-ls/awk.
for g in check-skills-flags check-schedule-consumers check-leg-nonvacuity-coverage check-dialect-translator-roster check-local-gate-parity check-notes-claims-selftest; do
	if ! bash "scripts/$g.sh"; then
		red "pre-commit: $g failed (a CI Lint-job guard)."
		exit 1
	fi
done

# ---- CI coverage guards ----
# These two run in CI's Lint job; without them here, adding
# integration-tagged tests in an uncovered package (or a tagged test
# whose name escapes its job's -run filter) passes the full local gate
# and only fails in CI — contradicting "make pre-commit runs everything
# CI runs". Both are pure git-ls-files/grep, sub-second — which is why
# they sit ABOVE the Go-staged early return (audit 2026-09-01 DDD-5):
# the shard list lives in ci.yml and a -run filter in a workflow file,
# so the commit that breaks either can stage no Go file at all.
if ! sh scripts/check-shard-coverage.sh; then
	red "pre-commit: check-shard-coverage failed (integration tests outside every CI shard)."
	exit 1
fi
if ! sh scripts/check-run-filter-coverage.sh; then
	red "pre-commit: check-run-filter-coverage failed (a tagged test would never run in any workflow)."
	exit 1
fi

# Only run Go checks if Go files are staged. Lets non-code commits
# (docs, CI config, etc.) skip the slow steps. Everything ABOVE this line
# is text-shaped and applies to every commit.
if ! git diff --cached --name-only --diff-filter=ACM | grep -q '\.go$'; then
	green "pre-commit: no Go files staged, skipping Go checks"
	exit 0
fi

echo "pre-commit: running gofumpt check, go vet, and tests..."

# ---- gofumpt ----
if ! command -v gofumpt >/dev/null 2>&1; then
	red "pre-commit: gofumpt not installed."
	echo "Install: go install mvdan.cc/gofumpt@latest"
	exit 1
fi
# gofumpt walks the FILESYSTEM (unlike go vet's module-scoped ./...), so
# exclude the gitignored .claude/ agent worktrees — live worktree agents
# keep mid-edit files there that are not this tree's problem (same
# reasoning as golangci-lint's .claude/ exclusion, v0.99.236).
unformatted=$(gofumpt -l . | grep -v '^\.claude/' | grep -v '/\.claude/' || true)
if [ -n "$unformatted" ]; then
	red "pre-commit: gofumpt would reformat the following files:"
	echo "$unformatted"
	echo ""
	echo "Run: gofumpt -w ."
	echo "Then: git add ... && git commit"
	exit 1
fi

# ---- go vet ----
if ! go vet ./...; then
	red "pre-commit: go vet failed."
	exit 1
fi

# ---- go vet, per build-tag combination ----
# Bare `go vet ./...` skips every build-tagged file, and `go build
# -tags=...` skips _test.go files — so a symbol rename that a tagged
# test still references passes both and only fails when that suite
# finally runs (the v0.58.1 retag class). vet-tags.sh discovers every
# tag combo in the tree and type-checks each one; results are cached
# by the Go build cache, so repeat runs cost seconds.
if ! sh scripts/vet-tags.sh; then
	red "pre-commit: vet-tags failed (a build-tagged file no longer type-checks)."
	exit 1
fi


# ---- go test (fast, no DB) ----
# -race is preferred but requires cgo. On Windows / minimal-toolchain
# setups CGO_ENABLED=0 by default, in which case we skip -race locally
# and rely on CI (Linux runners, cgo on) to catch races. Same checks
# either way, just a slightly slimmer guarantee on Windows.
test_args="-count=1"
if [ "$(go env CGO_ENABLED 2>/dev/null)" = "1" ]; then
	test_args="$test_args -race"
fi
if ! go test $test_args ./... >/dev/null; then
	red "pre-commit: tests failed."
	echo "Run: go test ./...  (to see the failure)"
	exit 1
fi

# ---- golangci-lint (mirrors CI's Lint job) ----
# Pre-v0.39.1 this gate was missing — gofumpt + go vet caught
# formatting + obvious-bug issues but unused-symbol / revive / etc.
# only ran in CI, which meant lint-only failures slipped through the
# local pre-commit gate for several releases. Adding it here matches
# the CI job exactly.
#
# Soft-skip when golangci-lint isn't installed (developer convenience)
# rather than hard-block — CI is the source of truth.
if command -v golangci-lint >/dev/null 2>&1; then
	# Version guard — WARN, never fail (M-1, audit 2026-08-26): CI pins
	# golangci-lint because v2.13.0 hangs indefinitely in its package-load
	# phase (ci.yml's pin comment; docs/dev/development.md), and a locally
	# different version can hang here or report different findings than
	# CI. Derived from ci.yml's `version:` line so the guard cannot drift
	# from the pin it cites; if extraction fails, stay silent — CI is the
	# source of truth.
	pinned=$(sed -n 's/^[[:space:]]*version:[[:space:]]*\(v[0-9][0-9.]*\)[[:space:]]*$/\1/p' .github/workflows/ci.yml | head -n 1)
	installed="v$(golangci-lint version --short 2>/dev/null || true)"
	if [ -n "$pinned" ] && [ "$installed" != "$pinned" ]; then
		printf "\033[33m%s\033[0m\n" "pre-commit: WARNING: golangci-lint $installed does not match CI's pinned $pinned (v2.13.0 hangs)."
		echo "Align with: go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@$pinned"
	fi
	if ! golangci-lint run; then
		# A stale analysis cache reports PHANTOM issues after a sibling
		# git worktree is removed (typecheck/unused findings pointing at
		# files that no longer exist — hit 4x with the worktree-agent
		# flow). Self-heal: clean the cache and retry ONCE. A cold-cache
		# run costs minutes, so this only happens on failure — real
		# findings reproduce identically on the retry.
		echo "pre-commit: golangci-lint failed; retrying once with a clean cache (stale-worktree phantom check)..."
		golangci-lint cache clean
		if ! golangci-lint run; then
			red "pre-commit: golangci-lint failed."
			echo "Run: golangci-lint run  (to see the failures inline)"
			exit 1
		fi
	fi
else
	echo "pre-commit: golangci-lint not installed; skipping (install: https://golangci-lint.run/welcome/install/)"
fi

green "pre-commit: OK"
